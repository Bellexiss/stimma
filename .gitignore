# ============================================
# Bitrix (1С-Битрикс: Управление сайтом)
# ============================================

# Ядро Битрикса
/upload/
/bitrix/*
!/bitrix/php_interface/
!/bitrix/php_interface/*
!/bitrix/templates/
!/bitrix/templates/*
# Кэш
/cache/

# Скомпилированные стили и скрипты (если собираются локально)
# /bitrix/cache/css/
# /bitrix/cache/js/

# ============================================
# Bitrix D7 / composer (если используется)
# ============================================
/bitrix/composer.json
/bitrix/composer.lock
/bitrix/vendor/

# ============================================
# Зависимости и сборка фронтенда
# ============================================
/local/vendor/
/local/components/

# Если используешь npm/yarn для сборки
node_modules/
package-lock.json
yarn.lock
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Собранные файлы фронтенда (если собираешь и коммитишь исходники)
# Раскомментируй, если собираешь локально и НЕ хочешь коммитить результат:
# /local/dist/
# /local/build/
# /local/css/build/
# /local/js/build/

# ============================================
# Бекапы и временные файлы Битрикса
# ============================================
*.tar.gz
*.tar
*.zip
*.xml
*.txt
*.html
*.bak
*.old
*.json
*.well-known/
*_backup/
api/ai/catalog.json
/api/ai/catalog.json
/bitrix/backup/
/bitrix/tmp/
/bitrix/geo/

# ============================================
# Окружение и секреты
# ============================================
/.env
/.env.local
/.env.*.local

# Конфиги с паролями
/.htaccess.bak
/dbconn.php.bak

# ============================================
# IDE и редакторы
# ============================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============================================
# Логи
# ============================================
*.log
/logs/

# ============================================
# Прочее
# ============================================
*.tmp
*.temp
.sass-cache/
.tmp/
*.ini
/bitrix/.settings.php
bitrix/.settings.php
/bitrix/php_interface/dbconn.php
bitrix/php_interface/dbconn.php